// world_save.fbs — v5 world save container (promoted solution, META §32).
//
// Replaces the hand-rolled binary body of v1-v4 (magic + append_u32/read_u16
// by hand) with a typed, verifiable schema. The outer framing is unchanged:
// "VCWLD" + u32 version(5) + <this buffer> + BLAKE3-256(32 bytes).
//
// The loader keeps the v1-v4 manual parser for legacy saves; v5 buffers are
// validated with flatbuffers::Verifier before any accessor is used.

namespace engine.voxel.save;

// One dynamic runtime block id (>= BlockType::Count) and its persistent UUID.
// Builtin ids are implied by the stable enum and are NOT in the palette.
table PaletteEntry {
  id: ushort;
  uuid: string;
}

// One chunk column: cx/cz, vertical extent, then the block ids (u16 each) and
// the fluid-level bytes (one per voxel), both in y,z,x order — the same layout
// the v1-v4 binary format used.
table ChunkEntry {
  cx: int;
  cz: int;
  extent: uint;
  blocks: [ushort];
  fluid: [ubyte];
}

// One block entity (v3+): position, registered type id, the project's data
// version and its opaque serialized blob.
table BlockEntityEntry {
  x: int;
  y: int;
  z: int;
  type_id: string;
  data_version: uint;
  blob: [ubyte];
}

// One project component on a world entity: registered type id, the project's
// data version and the opaque serialized blob.
table EntityComponentEntry {
  type: string;
  version: uint;
  blob: [ubyte];
}

// One region tile (added 2026-08-15, FALTANTES §4 item 1): a fixed NxN chunk
// area of the paged save. A region-backed storage persists each region as its
// own page ("r.<x>.<z>") next to the "world" manifest page; the manifest
// carries the region list so a loader restores every page. Optional field:
// monolithic v5 saves have no regions (null == "not paged").
table RegionEntry {
  x: int;
  z: int;
}

// One world entity (added 2026-08-14, META section 15): registered entity
// type, position, builtin health, tick policy and project components. The
// field on WorldSave is optional, so v5 buffers written before this addition
// still load (world_entities() == null means "none").
table EntityEntry {
  type: string;
  x: float;
  y: float;
  z: float;
  health: float;
  max_health: float;
  tick_interval: float;
  components: [EntityComponentEntry];
  // Stable cross-world reference id (META §19 "referências persistentes"):
  // a project-owned persistent string that survives save/load, so references
  // between worlds keep resolving after reloads. Optional: absent/empty means
  // the entity has no stable id (v5 buffers written before this field still
  // load — flatbuffers nulls the field).
  stable_id: string;
}

// One registered plugin/service version (FALTANTES §4 item 4 "versão dos
// plugins"): the (name, version) identity of a plugin that produced content
// in this save. The engine stores the list verbatim (set_world_metadata) and
// restores it on load; interpretation/diagnostics belong to the caller.
table PluginVersionEntry {
  name: string;
  version: string;
}

// World identity + content provenance (FALTANTES §4 item 4): seed, world
// name, rules JSON, a deterministic fingerprint of the block registry that
// produced the blocks, and the registered plugin versions. Optional field on
// WorldSave: v5 buffers written before this table (null meta) load with
// default metadata (seed 0, no name/rules/plugins, no registry stamp), so
// older v5 saves keep working unchanged.
table WorldMeta {
  seed: ulong;
  world_name: string;
  rules_json: string;
  registry_version: ulong;
  plugins: [PluginVersionEntry];
}

table WorldSave {
  palette: [PaletteEntry];
  chunks: [ChunkEntry];
  entities: [BlockEntityEntry];
  world_entities: [EntityEntry];
  regions: [RegionEntry];
  // Opaque scheduler state (FALTANTES §6 item 129): the WorldScheduler's
  // versioned binary capture (clock + pending queues), so a dedicated/headless
  // server restores tick work exactly where the saved session was. Optional:
  // null/empty means "no scheduler state" (e.g. v1-v4 migrated saves start a
  // fresh clock). The engine never interprets the bytes here.
  scheduler_state: [ubyte];
  // World identity + content provenance (FALTANTES §4 item 4). Optional: null
  // means "no metadata" (older v5 buffers); loaders restore it into
  // world_metadata().
  meta: WorldMeta;
}

root_type WorldSave;
file_identifier "WLD5";
