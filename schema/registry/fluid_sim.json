{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vulkancraft.engine/schema/config/fluid_sim.json",
  "title": "fluid_sim config asset",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "description": "asset name (becomes the file name)",
      "type": "string"
    },
    "version": {
      "description": "must be 1",
      "default": 1,
      "type": "integer"
    },
    "gravity": {
      "description": "> 0",
      "default": 9.81,
      "type": "number"
    },
    "dt": {
      "description": "time step, > 0",
      "default": 0.0166667,
      "type": "number"
    },
    "damping": {
      "description": "velocity damping [0, 1]",
      "default": 0.999,
      "type": "number"
    },
    "viscosity": {
      "description": "viscosity coefficient >= 0",
      "default": 0.001,
      "type": "number"
    },
    "gridSize": {
      "description": "NxN heightfield, > 0",
      "default": 64,
      "type": "integer"
    },
    "cellSize": {
      "description": "world units per cell, > 0",
      "default": 1,
      "type": "number"
    },
    "solverIterations": {
      "description": "Jacobi iterations per step, > 0",
      "default": 4,
      "type": "integer"
    },
    "surfaceTension": {
      "description": "surface tension coefficient >= 0",
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "name"
  ]
}
