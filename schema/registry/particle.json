      "description": "asset name (becomes the file name)",
      "type": "string"
    },
    "version": {
      "description": "must be 1",
      "default": 1,
      "type": "integer"
    },
    "px": {
      "description": "ParticleEmitter.px (component schema default 0)",
      "default": 0,
      "type": "number"
    },
    "py": {
      "description": "ParticleEmitter.py (component schema default 0)",
      "default": 0,
      "type": "number"
    },
    "pz": {
      "description": "ParticleEmitter.pz (component schema default 0)",
      "default": 0,
      "type": "number"
    },
    "dx": {
      "description": "ParticleEmitter.dx (component schema default 0)",
      "default": 0,
      "type": "number"
    },
    "dy": {
      "description": "ParticleEmitter.dy (component schema default 1)",
      "default": 1,
      "type": "number"
    },
    "dz": {
      "description": "ParticleEmitter.dz (component schema default 0)",
      "default": 0,
      "type": "number"
