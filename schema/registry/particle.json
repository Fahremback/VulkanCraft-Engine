    },
    "restitution": {
      "description": "ParticleEmitter.restitution (component schema default 0.35)",
      "default": 0.35,
      "type": "number"
    },
    "burst": {
      "description": "ParticleEmitter.burst (component schema default 0)",
      "default": 0,
      "type": "number"
