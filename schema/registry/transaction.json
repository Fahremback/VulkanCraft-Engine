{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vulkancraft.engine/schema/config/transaction.json",
  "title": "transaction config asset",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "description": "asset name (becomes the file name)",
      "type": "string"
    },
    "version": {
      "description": "must be 1",
      "default": 1,
      "type": "integer"
    },
    "edits": {
      "description": "[{ position: [x,y,z] (integers), block_id (uint, 0 = Air) }]",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "maxEdits": {
      "description": "per-transaction edit cap; 0 = unlimited",
      "default": 0,
      "type": "integer"
    },
    "maxBoxVolume": {
      "description": "bounding-box volume cap; 0 = unlimited",
      "default": 0,
      "type": "integer"
    }
  },
  "required": [
    "name",
    "edits"
  ]
}
