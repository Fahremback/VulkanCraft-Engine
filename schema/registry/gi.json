{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vulkancraft.engine/schema/config/gi.json",
  "title": "gi config asset",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "description": "asset name (becomes the file name)",
      "type": "string"
    },
    "version": {
      "description": "must be 1",
      "default": 1,
      "type": "integer"
    },
    "resolution": {
      "description": "probes per axis [4, 32]",
      "default": 16,
      "type": "integer"
    },
    "bounces": {
      "description": "multi-bounce gather iterations [1, 8]",
      "default": 2,
      "type": "integer"
    },
    "skylight": {
      "description": "shadowed ambient RGB term",
      "default": [
        0.05,
        0.07,
        0.1
      ],
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "intensity": {
      "description": "global scale on gathered light [0.01, 64]",
      "default": 1,
      "type": "number"
    },
    "cascadeCount": {
      "description": "probe clipmap cascades [1, 6]",
      "default": 6,
      "type": "integer"
    },
    "probesPerFrame": {
      "description": "bake budget per frame >= 1",
      "default": 192,
      "type": "integer"
    },
    "baseSpacing": {
      "description": "cascade base spacing meters >= 0.5",
      "default": 4,
      "type": "number"
    },
    "cascadeScale": {
      "description": ">= 2",
      "default": 4,
      "type": "number"
    },
    "sunRefreshAngleDegrees": {
      "description": "sun-revision threshold [0.25, 15]",
      "default": 2,
      "type": "number"
    },
    "maxDistance": {
      "description": "form-factor cull distance > 0",
      "default": 128,
      "type": "number"
    }
  },
  "required": [
    "name"
  ]
}
