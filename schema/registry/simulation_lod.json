{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vulkancraft.engine/schema/simulation/simulation_lod.json",
  "title": "simulation_lod simulation LOD spec",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "description": "asset name (becomes the file name)",
      "type": "string"
    },
    "version": {
      "description": "must be 1",
      "default": 1,
      "type": "integer"
    },
    "cellSize": {
      "description": "region cell size in world units, > 0",
      "default": 16,
      "type": "number"
    },
    "fullRadius": {
      "description": "distance within which relevance == 1, >= 0",
      "default": 48,
      "type": "number"
    },
    "falloffRadius": {
      "description": "distance at which relevance == 0, > fullRadius",
      "default": 320,
      "type": "number"
    },
    "dayLengthSeconds": {
      "description": "length of a world day (s), > 0",
      "default": 240,
      "type": "number"
    },
    "daysPerSeason": {
      "description": ">= 1 (4 seasons)",
      "default": 30,
      "type": "integer"
    },
    "tiers": {
      "description": "simulation budget tiers, non-empty, sorted by minRelevance DESCENDING: [{ name (unique), mode: full|coarse|aggregate|sleeping, minRelevance in [0, 1] (strictly descending), updateInterval >= 0 (s between ticks; 0 = every update), sleepAfterIdle >= 0, maxRegions >= 0 (0 = unlimited), aggregateInterval >= 0 }]",
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "name",
    "tiers"
  ]
}
