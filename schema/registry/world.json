{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vulkancraft.engine/schema/config/world.json",
  "title": "world config asset",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "description": "unique world name (becomes the file name)",
      "type": "string"
    },
    "version": {
      "description": "must be 1",
      "default": 1,
      "type": "integer"
    },
    "seed": {
      "description": "per-world generator/behavior RNG seed",
      "default": 0,
      "type": "integer"
    },
    "profile": {
      "description": "name of a world profile asset in Content/Profiles (WorldSpec.profileJson)",
      "default": "",
      "type": "string"
    },
    "portals": {
      "description": "[{ from_world, from: [x,y,z], to_world, to: [x,y,z], yaw_degrees }]",
      "default": [],
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rulesJson": {
      "description": "optional opaque rules document (must be well-formed JSON when non-empty)",
      "default": "",
      "type": "string"
    },
    "savePath": {
      "description": "default persistence location for load_world/save_world",
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}
